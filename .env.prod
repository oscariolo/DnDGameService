# Environment
NODE_ENV=production
PORT=3001

# MongoDB
MONGO_URI=mongodb://admin:adminpassword@mongodb:27017/dnd_game_service?authSource=admin
MONGO_DB_NAME=dnd_game_service

# Spring Boot (internal)
SPRINGBOOT_AUTH_URL=http://dndSpringBackend:8080/api/auth
SPRINGBOOT_URL=http://dndSpringBackend:8080

# WebSocket
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Game Session
SESSION_TIMEOUT=3600000
MAX_PLAYERS_PER_SESSION=10

# Logging
LOG_LEVEL=info
